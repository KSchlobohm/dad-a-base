{
  "name": "dad-a-base",
  "version": "1.0.0",
  "private": true,
  "description": "A simple web app that displays a curated set of dad jokes in a tap-to-reveal flashcard-style interface.",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "tsx --test src/domain/jokeDeck.test.ts src/jokes.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run lint && npm test && npm run build && playwright test",
    "evidence": "node scripts/capture-evidence.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KSchlobohm/dad-a-base.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/KSchlobohm/dad-a-base/issues"
  },
  "homepage": "https://github.com/KSchlobohm/dad-a-base#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
